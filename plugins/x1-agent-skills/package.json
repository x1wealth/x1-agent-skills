{
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.6"
  },
  "description": "Portable, governed X1 agent skills with synthetic evaluations",
  "engines": {
    "node": ">=22.23.2 <23 || >=24.19.0"
  },
  "license": "Apache-2.0",
  "name": "@x1-wealth/agent-skills-evals",
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "overrides": {
      "body-parser@<2.4.0": "2.4.0",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "hono@<4.13.11": "4.13.11",
      "ip-address@<10.7.4": "10.7.4",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.1": "6.16.1"
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/x1wealth/x1-agent-skills"
  },
  "scripts": {
    "eval:host": "node skills/handle-capital-call/evals/run-host-eval.mjs",
    "eval:meetings": "node scripts/evaluate-meeting-skill.mjs",
    "eval:oracle": "node skills/handle-capital-call/evals/evaluate.mjs --suite all",
    "test": "node --test skills/handle-capital-call/evals/evaluate.test.mjs skills/handle-capital-call/evals/run-host-eval.test.mjs scripts/evaluate-meeting-skill.test.mjs scripts/evaluate-review-k1.test.mjs scripts/mock-x1-k1-household.test.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "eval:k1": "node scripts/evaluate-review-k1.mjs",
    "try:k1": "node scripts/try-review-k1.mjs",
    "mock:k1": "node scripts/mock-x1-k1-household.mjs",
    "agent:k1": "node scripts/run-agent-review-k1.mjs"
  },
  "type": "module",
  "version": "0.5.4"
}
